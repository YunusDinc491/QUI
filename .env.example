# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur. ".env" git'e girmez.
# Gerçek anahtar/parola bu dosyaya YAZILMAZ; yalnızca örnek ve yerel geliştirme değerleri vardır.

# --- Yerel geliştirme: Docker ile Postgres + Redis (docker-compose.yml) ---
POSTGRES_DB=senbilirsin
POSTGRES_USER=senbilirsin
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- API bağlantıları (appsettings'e ortam değişkeni olarak eşlenir) ---
ConnectionStrings__Default=Host=localhost;Port=5433;Database=senbilirsin;Username=senbilirsin;Password=CHANGE_ME_LOCAL_ONLY
ConnectionStrings__Redis=localhost:6380

# --- Sonraki fazlarda doldurulacak (şimdilik boş) ---
# Faz 1: Firebase
Firebase__ProjectId=senbilirsin-832b8
# Faz 2: Cloudflare R2
R2__AccountId=
R2__AccessKeyId=
R2__SecretAccessKey=
R2__Bucket=
R2__PublicBaseUrl=
# Dosya depolama: Local (geliştirme, .local/uploads) | R2 (üretim)
Storage__Provider=Local
# Faz 6: kupon kodu şifreleme anahtarı (Base64, 32 bayt) — üret ve SADECE Railway/.env içinde sakla
Coupons__EncryptionKey=
# Faz 7: AdMob SSV
AdMob__SsvEnabled=false

# Yönetim paneli: TOTP anahtarını şifreleyen anahtar (Base64, 32 bayt) ve oturum imza anahtarı (Base64, en az 32 bayt)
Admin__SecretKey=
Admin__JwtKey=
